# -*- coding: utf-8 -*-
# ตัวอย่างสูตร 3D: บ้านโมเดิร์นสองชั้นพร้อมสระว่ายน้ำ (หน่วยเป็นเมตร แกน Z ชี้ขึ้น)
#
# รัน:      yotathai-ai build-3d modern-house-3d.py modern-house.igz
# เปิดดู:   yotathai-ai open modern-house.igz      (แล้วหมุน/ซูม/แก้ด้วยมือต่อได้ทันที)
# ทำแบบ:    yotathai-ai model-to-2d modern-house.igz modern-house-sheet.dxf
#
# วิธีอ่านสูตรนี้: แบ่งเป็นส่วนๆ ตามหัวข้อ ----- แต่ละส่วนเรียกฟังก์ชันของโปรแกรม
#   box(มุมล่าง, ขนาด)    กล่องสี่เหลี่ยม      wall(จุดเริ่ม, จุดจบ, ...)  ผนังเจาะช่องเปิดได้
#   prism(รูปแบน, ทิศ)    ดันรูปแบนเป็นก้อน     revolve(โปรไฟล์)            ปั้นหมุนรอบแกน Z (ลำต้น เสา ลูกกลม)
# ลองเปลี่ยนตัวเลขแล้วรันใหม่ได้เลย เช่น ความสูงชั้น ขนาดสระ หรือสีวัสดุ

import math
from PySide6.QtGui import QVector3D      # ใช้เลื่อนตำแหน่งชิ้นงาน (ในโปรแกรมมีให้อยู่แล้ว เขียนซ้ำเพื่อให้รันนอกโปรแกรมได้)

# ----------------------------------------------------------------- สีวัสดุ
WHITE  = (0.95, 0.95, 0.93, 1.0)   # ปูนฉาบสีขาว
CHAR   = (0.16, 0.17, 0.19, 1.0)   # เทาถ่าน (กรอบอลูมิเนียม หลังคา)
STONE  = (0.30, 0.30, 0.33, 1.0)   # หินเทาเข้ม
CONC   = (0.68, 0.68, 0.66, 1.0)   # คอนกรีตขัดมัน
TIMBER = (0.62, 0.41, 0.22, 1.0)   # ไม้
DECK   = (0.55, 0.37, 0.22, 1.0)   # พื้นไม้เดคกิ้ง
GLASS  = (0.55, 0.78, 0.90, 1.0)   # กระจก (ทำให้โปร่งแสงด้านล่าง)
GRASS  = (0.35, 0.56, 0.29, 1.0)   # สนามหญ้า
LEAF   = (0.21, 0.44, 0.22, 1.0)   # ใบไม้เข้ม
LEAF2  = (0.32, 0.57, 0.27, 1.0)   # ใบไม้อ่อน
TRUNK  = (0.38, 0.27, 0.18, 1.0)   # ลำต้น
WATER  = (0.18, 0.70, 0.84, 1.0)   # น้ำในสระ
SOFA   = (0.34, 0.37, 0.42, 1.0)   # ผ้าโซฟา

# ----------------------------------------------------------------- ตัวช่วยเล็กๆ
def move(g, dx=0.0, dy=0.0, dz=0.0):
    """เลื่อนกลุ่มชิ้นงานไปยังตำแหน่งที่ต้องการ"""
    for v in list(g.mesh.vertices):
        g.mesh.move_vertex(v, QVector3D(dx, dy, dz))
    return g

def solid(x, y, z, dx, dy, dz, color, name):
    """กล่องทึบ: มุมล่างซ้าย (x, y, z) และขนาด (dx, dy, dz)"""
    return box((x, y, z), (dx, dy, dz), name=name, color=color)

def glass(x, y, z, dx, dy, dz, name, opacity=0.32):
    """กล่องกระจกโปร่งแสง"""
    g = box((x, y, z), (dx, dy, dz), name=name, color=GLASS)
    for f in g.mesh.faces:
        f.attrs["opacity"] = opacity
    return g

def rect_walls(x0, y0, x1, y1, z0, h, t, color, name, sides="SENW", openings=None):
    """ผนังสี่ด้านของอาคารสี่เหลี่ยม (ด้าน S=ใต้/หน้าบ้าน E=ตะวันออก N=เหนือ W=ตะวันตก)
    openings = {"S": [(ระยะจากมุม, ความสูงขอบล่าง, กว้าง, สูง), ...]}  ขอบล่าง 0 = ประตู"""
    openings = openings or {}
    ya = y0 + (t if "S" in sides else 0.0)
    yb = y1 - (t if "N" in sides else 0.0)
    lines = {"S": ((x0, y0), (x1, y0), 0.0), "E": ((x1, ya), (x1, yb), ya - y0),
             "N": ((x1, y1), (x0, y1), 0.0), "W": ((x0, yb), (x0, ya), y1 - yb)}
    for side in sides:
        a, b, shift = lines[side]
        ops = [(o - shift, s, w_, h_) for (o, s, w_, h_) in openings.get(side, [])]
        wall(a, b, height=h, thickness=t, openings=ops, z0=z0, name=f"{name} · ผนัง{side}", color=color)

def fill(side, rect, t, z0, off, sill, w_, h_, name, kind="glass"):
    """ใส่กระจกพร้อมกรอบ (หรือบานประตูไม้) ในช่องเปิดของผนัง"""
    x0, y0, x1, y1 = rect
    if side == "S":   axis, a, c = "x", x0 + off, y0 + t / 2; b = a + w_
    elif side == "N": axis, b, c = "x", x1 - off, y1 - t / 2; a = b - w_
    elif side == "E": axis, a, c = "y", y0 + off, x1 - t / 2; b = a + w_
    else:             axis, b, c = "y", y1 - off, x0 + t / 2; a = b - w_
    zb, zt = z0 + sill, z0 + sill + h_

    def panel(u0, u1, v0, v1, d, color, nm, opacity=None):
        if axis == "x": g = box((u0, c - d / 2, v0), (u1 - u0, d, v1 - v0), name=nm, color=color)
        else:           g = box((c - d / 2, u0, v0), (d, u1 - u0, v1 - v0), name=nm, color=color)
        if opacity:
            for f in g.mesh.faces:
                f.attrs["opacity"] = opacity
        return g
    if kind == "door":
        panel(a, b, zb, zt, 0.07, TIMBER, f"{name} · บานประตู")
        panel(b - 0.18, b - 0.12, zb + 1.0, zb + 1.1, 0.14, CHAR, f"{name} · มือจับ")
    else:
        fr = 0.07
        panel(a, b, zb, zt, 0.03, GLASS, f"{name} · กระจก", 0.32)
        panel(a, b, zt - fr, zt, 0.12, CHAR, f"{name} · กรอบบน")
        panel(a, b, zb, zb + fr, 0.12, CHAR, f"{name} · กรอบล่าง")
        panel(a, a + fr, zb + fr, zt - fr, 0.12, CHAR, f"{name} · กรอบซ้าย")
        panel(b - fr, b, zb + fr, zt - fr, 0.12, CHAR, f"{name} · กรอบขวา")

def curtain(x0, x1, y, z0, z1, cols, name):
    """ผนังกระจกเต็มความสูง มีเสาแบ่งช่อง"""
    glass(x0, y - 0.015, z0, x1 - x0, 0.03, z1 - z0, f"{name} · กระจก")
    w_ = (x1 - x0) / cols
    for i in range(cols + 1):
        solid(x0 + i * w_ - 0.04, y - 0.07, z0, 0.08, 0.14, z1 - z0, CHAR, f"{name} · เสาแบ่ง")
    for zz in (z0, z0 + 2.3, z1 - 0.08):
        solid(x0, y - 0.07, zz, x1 - x0, 0.14, 0.08, CHAR, f"{name} · คานแบ่ง")

def ball(cx, cy, cz, r, color, name, squash=1.0, seg=14):
    """ก้อนกลม (พุ่มไม้ เรือนยอด) สร้างจากการหมุนครึ่งวงกลม"""
    prof = []
    for k in range(9):
        ang = -math.pi / 2 + math.pi * k / 8
        prof.append((max(r * math.cos(ang), 0.02), cz + r * squash * math.sin(ang)))
    return move(revolve(prof, segments=seg, name=name, color=color), cx, cy)

def tree(x, y, h=4.8, r=1.7, leaf=LEAF, name="ต้นไม้"):
    trunk = revolve([(0.17, 0.0), (0.10, h * 0.62)], segments=10, name=f"{name} · ลำต้น", color=TRUNK)
    move(trunk, x, y)
    ball(x, y, h * 0.62 + r * 0.45, r, leaf, f"{name} · เรือนยอด", squash=0.85)
    ball(x + r * 0.45, y - r * 0.15, h * 0.62 + r * 0.9, r * 0.62, LEAF2, f"{name} · เรือนยอดบน", squash=0.85)

def palm(x, y, h=6.5, name="ปาล์ม"):
    """ปาล์ม: ลำต้นเรียวเล็กลง + ทางใบ 9 ทางแผ่ออกรอบยอด"""
    trunk = revolve([(0.20, 0.0), (0.13, h)], segments=10, name=f"{name} · ลำต้น", color=TRUNK)
    move(trunk, x, y)
    for k in range(9):
        ang = 2 * math.pi * k / 9
        ca, sa = math.cos(ang), math.sin(ang)
        L = 2.9 if k % 2 == 0 else 2.5
        w = 0.42
        sag = 0.30            # ปลายใบตกลง
        def P(d, side):       # จุดบนใบ: d = ระยะตามแนวใบ, side = ระยะออกข้าง
            return (x + ca * d - sa * side, y + sa * d + ca * side, h + 0.15 - sag * d)
        leaf = [P(0.05, 0.0), P(L * 0.38, w), P(L * 0.75, w * 0.55), P(L, 0.0), P(L * 0.75, -w * 0.55), P(L * 0.38, -w)]
        prism(leaf, (0, 0, 0.03), name=f"{name} · ทางใบ", color=LEAF2 if k % 2 == 0 else LEAF)
    ball(x, y, h + 0.1, 0.35, LEAF, f"{name} · ยอดอ่อน", squash=1.0, seg=8)

def car(x0, y0, color=(0.78, 0.11, 0.12, 1.0), name="รถยนต์"):
    """รถเก๋งจากภาพด้านข้าง (แกนยาวของรถอยู่ตามแกน Y)"""
    prof = [(0.00, 0.30), (0.00, 0.78), (0.95, 0.93), (1.45, 1.02), (1.95, 1.46),
            (3.10, 1.46), (3.80, 1.02), (4.40, 0.96), (4.45, 0.30)]
    prism([(x0, y0 + yy, zz) for yy, zz in prof], (1.8, 0, 0), name=f"{name} · ตัวถัง", color=color)
    win = [(1.52, 1.05), (1.98, 1.40), (3.05, 1.40), (3.62, 1.05)]
    g = prism([(x0 - 0.01, y0 + yy, zz) for yy, zz in win], (1.82, 0, 0), name=f"{name} · กระจก", color=(0.07, 0.09, 0.13, 1.0))
    for f in g.mesh.faces:
        f.attrs["opacity"] = 0.75
    for yc in (0.95, 3.50):
        for xw in (x0 - 0.02, x0 + 1.60):
            ring = [(xw, y0 + yc + 0.33 * math.cos(2 * math.pi * k / 16), 0.33 + 0.33 * math.sin(2 * math.pi * k / 16)) for k in range(16)]
            prism(ring, (0.22, 0, 0), name=f"{name} · ล้อ", color=(0.08, 0.08, 0.09, 1.0))

# ----------------------------------------------------------------- ระดับความสูงหลัก
Z0   = 0.30    # พื้นชั้นล่าง (ยกจากดิน)
H0   = 3.20    # ความสูงชั้นล่าง
ZS   = Z0 + H0 # ใต้ท้องพื้นชั้นสอง = 3.50
Z1   = 3.80    # พื้นชั้นสอง
H1   = 3.00    # ความสูงชั้นสอง
ZR   = Z1 + H1 # ใต้ท้องหลังคา = 6.80
T    = 0.25    # ความหนาผนัง

# ----------------------------------------------------------------- ที่ดินและสนามหญ้า
solid(-9, -14.5, -0.4, 40, 31, 0.4, GRASS, "ที่ดิน · สนามหญ้า")
solid(14.6, -14.5, 0.0, 6.4, 24.5, 0.04, CONC, "ที่ดิน · ทางรถเข้า")

# ----------------------------------------------------------------- ฐานบ้านและระเบียงหน้า
solid(-0.6, -0.6, 0.0, 15.2, 9.2, Z0, CONC, "ฐานบ้าน")
solid(-0.6, -2.3, 0.0, 15.2, 1.7, Z0, CONC, "ระเบียงหน้าบ้าน")
solid(2.4, -3.3, 0.0, 5.2, 1.0, 0.15, CONC, "ขั้นบันไดหน้าบ้าน")

# ----------------------------------------------------------------- ชั้นล่าง: ห้องนั่งเล่นกระจก + ส่วนบริการหินเทา
rect_walls(0, 0, 9, 8, Z0, H0, T, WHITE, "ห้องนั่งเล่น", sides="WN",
           openings={"W": [(1.4, 0.9, 3.2, 1.6)], "N": [(1.0, 1.6, 2.2, 1.0), (5.8, 1.6, 2.2, 1.0)]})
fill("W", (0, 0, 9, 8), T, Z0, 1.4, 0.9, 3.2, 1.6, "ห้องนั่งเล่น หน้าต่างตะวันตก")
fill("N", (0, 0, 9, 8), T, Z0, 1.0, 1.6, 2.2, 1.0, "ห้องนั่งเล่น หน้าต่างเหนือ 1")
fill("N", (0, 0, 9, 8), T, Z0, 5.8, 1.6, 2.2, 1.0, "ห้องนั่งเล่น หน้าต่างเหนือ 2")
curtain(0.25, 9.0, 0.0, Z0, Z0 + H0, 5, "ห้องนั่งเล่น ผนังกระจกหน้าบ้าน")

rect_walls(9, 0, 14, 8, Z0, H0, T, STONE, "ส่วนบริการ",
           openings={"S": [(1.0, 0.0, 1.4, 2.5), (3.1, 0.5, 0.55, 2.3)], "E": [(2.4, 1.0, 1.8, 1.0)]})
fill("S", (9, 0, 14, 8), T, Z0, 1.0, 0.0, 1.4, 2.5, "ประตูหลักบ้าน", kind="door")
fill("S", (9, 0, 14, 8), T, Z0, 3.1, 0.5, 0.55, 2.3, "ช่องแสงแนวตั้ง")
fill("E", (9, 0, 14, 8), T, Z0, 2.4, 1.0, 1.8, 1.0, "หน้าต่างส่วนบริการ")

# พื้นชั้นสอง (คอนกรีต) ส่วนซ้ายเป็นระเบียงเปิดโล่ง ส่วนขวายื่นออกหน้าบ้าน
solid(-0.3, -0.3, ZS, 5.2, 8.6, 0.30, CONC, "พื้นชั้นสอง · ระเบียง")
solid(4.9, -1.7, ZS, 9.5, 9.9, 0.30, CONC, "พื้นชั้นสอง · ส่วนยื่น")

# ----------------------------------------------------------------- ชั้นสอง: ก้อนสีขาวยื่นออกหน้าบ้าน
rect_walls(5.2, -1.5, 14.2, 8.0, Z1, H1, T, WHITE, "ชั้นสอง",
           openings={"S": [(0.7, 0.6, 4.4, 2.0), (5.6, 0.6, 2.7, 2.0)],
                     "E": [(1.8, 0.9, 2.2, 1.6), (5.3, 0.9, 2.0, 1.6)],
                     "N": [(1.5, 0.9, 2.4, 1.6), (6.0, 0.9, 2.0, 1.6)],
                     "W": [(5.8, 0.0, 2.4, 2.4)]})
R2 = (5.2, -1.5, 14.2, 8.0)
fill("S", R2, T, Z1, 0.7, 0.6, 4.4, 2.0, "ชั้นสอง หน้าต่างกว้าง")
fill("S", R2, T, Z1, 5.6, 0.6, 2.7, 2.0, "ชั้นสอง หน้าต่างหน้าบ้าน")
fill("E", R2, T, Z1, 1.8, 0.9, 2.2, 1.6, "ชั้นสอง หน้าต่างตะวันออก 1")
fill("E", R2, T, Z1, 5.3, 0.9, 2.0, 1.6, "ชั้นสอง หน้าต่างตะวันออก 2")
fill("N", R2, T, Z1, 1.5, 0.9, 2.4, 1.6, "ชั้นสอง หน้าต่างเหนือ 1")
fill("N", R2, T, Z1, 6.0, 0.9, 2.0, 1.6, "ชั้นสอง หน้าต่างเหนือ 2")
fill("W", R2, T, Z1, 5.8, 0.0, 2.4, 2.4, "ชั้นสอง ประตูกระจกออกระเบียง")

# ก้อนไม้ส่วนต่อเติม ชั้นสองด้านตะวันตก พร้อมระแนงไม้แนวตั้ง
solid(0.8, 3.0, Z1, 4.2, 5.0, H1, CHAR, "ส่วนไม้ · แกนกลาง")
x = 0.9
while x < 4.95:
    solid(x, 2.88, Z1, 0.10, 0.12, H1, TIMBER, "ส่วนไม้ · ระแนงหน้า")
    x += 0.2
y = 3.1
while y < 7.95:
    solid(0.68, y, Z1, 0.12, 0.10, H1, TIMBER, "ส่วนไม้ · ระแนงข้าง")
    y += 0.2

# หลังคาแบนบางๆ ยื่นออก
solid(5.0, -1.7, ZR, 9.4, 9.9, 0.28, WHITE, "หลังคา · ก้อนสีขาว")
solid(5.1, -1.6, ZR + 0.28, 9.2, 9.7, 0.04, CHAR, "หลังคา · ผิวกันซึม")
solid(0.6, 2.8, ZR, 4.4, 5.4, 0.28, WHITE, "หลังคา · ส่วนไม้")
solid(0.7, 2.9, ZR + 0.28, 4.2, 5.2, 0.04, CHAR, "หลังคา · ผิวกันซึม ส่วนไม้")

# เสากลมบางรับส่วนที่ยื่น
for cx in (5.9, 13.0):
    solid(cx, -1.35, Z0, 0.20, 0.20, H0, WHITE, "เสารับส่วนยื่น")

# ระเบียงชั้นสอง: ราวกระจก กระถางต้นไม้ เก้าอี้พักผ่อน
glass(-0.3, -0.30, Z1, 5.2, 0.04, 1.10, "ระเบียง · ราวกระจกหน้า", 0.28)
glass(-0.3, -0.30, Z1, 0.04, 3.4, 1.10, "ระเบียง · ราวกระจกข้าง", 0.28)
solid(-0.3, -0.31, Z1 + 1.10, 5.2, 0.06, 0.04, CHAR, "ระเบียง · ราวจับหน้า")
solid(-0.31, -0.3, Z1 + 1.10, 0.06, 3.4, 0.04, CHAR, "ระเบียง · ราวจับข้าง")
solid(2.2, 1.8, Z1, 1.8, 0.6, 0.5, WHITE, "ระเบียง · กระถางปลูกต้นไม้")
ball(3.1, 2.1, Z1 + 0.85, 0.55, LEAF2, "ระเบียง · พุ่มไม้", squash=0.9)
solid(0.6, 0.3, Z1, 1.9, 0.7, 0.28, WHITE, "ระเบียง · เก้าอี้พักผ่อน ฐาน")
solid(0.6, 0.3, Z1 + 0.28, 1.9, 0.7, 0.10, SOFA, "ระเบียง · เก้าอี้พักผ่อน เบาะ")

# ----------------------------------------------------------------- โรงจอดรถ
solid(14.8, -1.2, ZS - 0.2, 6.4, 8.6, 0.22, CHAR, "โรงจอดรถ · หลังคา")
for (cx, cy) in ((14.9, -1.1), (20.9, -1.1), (14.9, 7.2), (20.9, 7.2)):
    solid(cx, cy, 0.04, 0.18, 0.18, ZS - 0.24, WHITE, "โรงจอดรถ · เสา")
car(16.7, 0.8)

# ----------------------------------------------------------------- ข้าวของในห้องนั่งเล่น (มองเห็นผ่านกระจก)
solid(0.25, 0.1, Z0, 8.7, 7.8, 0.05, TIMBER, "ห้องนั่งเล่น · พื้นไม้")
solid(1.0, 4.0, Z0 + 0.05, 3.2, 0.95, 0.45, SOFA, "ห้องนั่งเล่น · โซฟา ที่นั่ง")
solid(1.0, 4.95, Z0 + 0.05, 3.2, 0.25, 0.85, SOFA, "ห้องนั่งเล่น · โซฟา พนัก")
solid(1.0, 1.7, Z0 + 0.05, 0.95, 2.3, 0.45, SOFA, "ห้องนั่งเล่น · โซฟา ด้านข้าง")
solid(2.4, 2.1, Z0 + 0.05, 1.6, 1.0, 0.35, WHITE, "ห้องนั่งเล่น · โต๊ะกลาง")
